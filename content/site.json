  "process": [
    {
      "title": "Free assessment",
      "text": "Tell us your product and target market. We identify the exact standard, scheme and documents in 24 hours."
    },
    {
      "title": "Testing & documents",
      "text": "We book BIS/NABL-recognised labs, prepare your technical file and handle the paperwork."
    },
    {
      "title": "Application & liaison",
      "text": "We file on the regulator portal, answer every query and track the application daily."
    },
    {
      "title": "Certificate & renewals",
      "text": "You get your licence, marking guidance and automated renewal reminders so it never lapses."
    }
  ],
  "whyUs": [
