---
import Layout from '../layouts/Layout.astro';
import SiteSearch from '../components/SiteSearch.astro';
---

<Layout title="Page not found | Instacertify" description="The page you are looking for has moved or no longer exists." noindex>
  <section class="container-page flex flex-col items-center py-20 text-center sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-[2rem] leading-tight font-bold sm:text-[2.5rem]">This page has moved</h1>
    <p class="mt-4 max-w-md text-slate-600">Search the site or tell us what you're looking for — we'll point you to the right certification.</p>
    <SiteSearch id="not-found-search" class="mt-8 w-full max-w-xl text-left" />
    <div class="mt-4 flex gap-6 text-sm font-semibold">
      <a href="/" class="inline-flex min-h-11 items-center text-brand-700 hover:underline">Home</a>
      <a href="/contact" class="inline-flex min-h-11 items-center text-brand-700 hover:underline">Contact us</a>
    </div>
  </section>
</Layout>
