---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
---

<Layout title="Page not found | Instacertify" description="The page you are looking for has moved or no longer exists." noindex>
  <section class="container-page flex flex-col items-center py-20 text-center sm:py-28">
    <p class="eyebrow">404</p>
    <h1 class="mt-3 text-[2rem] leading-tight font-bold sm:text-[2.5rem]">This page has moved</h1>
    <p class="mt-4 max-w-md text-slate-600">Search our services or tell us what you're looking for — we'll point you to the right certification.</p>
    <form action="/services" method="get" class="mt-8 flex w-full max-w-md gap-2">
      <label for="q" class="sr-only">Search services</label>
      <input id="q" name="q" type="search" placeholder="e.g. BIS CRS, EPR, WPC" class="field" />
      <button class="btn-secondary shrink-0"><Icon name="search" class="size-4" />Search</button>
    </form>
    <div class="mt-4 flex gap-6 text-sm font-semibold">
      <a href="/" class="inline-flex min-h-11 items-center text-brand-700 hover:underline">Home</a>
      <a href="/contact" class="inline-flex min-h-11 items-center text-brand-700 hover:underline">Contact us</a>
    </div>
  </section>
</Layout>
