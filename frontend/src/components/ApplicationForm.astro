---
import Icon from './Icon.astro';

interface Props {
  id: string;
  /** Vacancy slug; omit for a general application. */
  vacancy?: string;
  title?: string;
  subtitle?: string;
  retentionMonths?: number;
}

const { id, vacancy, title = 'Apply for this role', subtitle = 'Takes about 2 minutes. All fields except the CV are quick to fill.', retentionMonths = 12 } = Astro.props;
const noticePeriods = { immediate: 'Immediate', '15-days': '15 days', '30-days': '30 days', '60-days': '60 days', '90-days': '90 days or more' };
---

<div class="card relative p-5 sm:p-7">
  <form data-application-form={id} class="space-y-5" novalidate={false}>
    <div>
      <p class="text-lg font-semibold text-slate-900">{title}</p>
      <p class="mt-1 text-sm text-slate-500">{subtitle}</p>
    </div>

    {vacancy && <input type="hidden" name="vacancy" value={vacancy} />}
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <label class="label" for={`${id}-name`}>Full name</label>
        <input id={`${id}-name`} name="name" class="field" autocomplete="name" required minlength="2" maxlength="120" />
        <p data-error-for="name" class="mt-1 text-sm text-red-600" />
      </div>
      <div>
        <label class="label" for={`${id}-email`}>Email</label>
        <input id={`${id}-email`} name="email" type="email" class="field" autocomplete="email" required />
        <p data-error-for="email" class="mt-1 text-sm text-red-600" />
      </div>
      <div>
        <label class="label" for={`${id}-phone`}>Mobile number</label>
        <input id={`${id}-phone`} name="phone" type="tel" class="field" autocomplete="tel" inputmode="tel" required pattern="\+?[0-9 \-]{8,20}" title="Mobile number with country code, e.g. +91 98765 43210" placeholder="+91 98xxx xxxxx" />
        <p data-error-for="phone" class="mt-1 text-sm text-red-600" />
      </div>
      <div>
        <label class="label" for={`${id}-city`}>Current city</label>
        <input id={`${id}-city`} name="city" class="field" autocomplete="address-level2" maxlength="80" placeholder="e.g. Noida" />
      </div>
      <div>
        <label class="label" for={`${id}-experience`}>Total experience (years)</label>
        <input id={`${id}-experience`} name="experience_years" type="number" min="0" max="50" step="0.5" inputmode="decimal" class="field" placeholder="0 for freshers" />
        <p data-error-for="experience_years" class="mt-1 text-sm text-red-600" />
      </div>
      <div>
        <label class="label" for={`${id}-notice`}>Notice period</label>
        <select id={`${id}-notice`} name="notice_period" class="field">
          <option value="">Select</option>
          {Object.entries(noticePeriods).map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </div>
      <div>
        <label class="label" for={`${id}-current-ctc`}>Current CTC <span class="font-normal text-slate-500">(optional)</span></label>
        <input id={`${id}-current-ctc`} name="current_ctc" class="field" maxlength="40" placeholder="e.g. ₹4.5 LPA" />
      </div>
      <div>
        <label class="label" for={`${id}-expected-ctc`}>Expected CTC <span class="font-normal text-slate-500">(optional)</span></label>
        <input id={`${id}-expected-ctc`} name="expected_ctc" class="field" maxlength="40" placeholder="e.g. ₹6 LPA" />
      </div>
      <div class="sm:col-span-2">
        <label class="label" for={`${id}-linkedin`}>LinkedIn profile <span class="font-normal text-slate-500">(optional)</span></label>
        <input id={`${id}-linkedin`} name="linkedin_url" type="url" class="field" autocomplete="url" placeholder="https://www.linkedin.com/in/your-name" />
        <p data-error-for="linkedin_url" class="mt-1 text-sm text-red-600" />
      </div>
    </div>

    <div>
      <span class="label" id={`${id}-cv-label`}>Your CV</span>
      <input id={`${id}-cv`} name="cv" type="file" required accept=".pdf,.doc,.docx,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document" aria-labelledby={`${id}-cv-label`} class="peer sr-only" />
      <label
        for={`${id}-cv`}
        data-cv-drop
        class="peer-focus-visible:ring-2 peer-focus-visible:ring-brand-500 peer-focus-visible:ring-offset-2 flex cursor-pointer flex-col items-center justify-center gap-1.5 rounded-xl border-2 border-dashed border-slate-300 bg-slate-50 px-4 py-6 text-center transition hover:border-brand-500 hover:bg-brand-50/40 data-[dragging=true]:border-brand-700 data-[dragging=true]:bg-brand-50 data-[filled=true]:border-solid data-[filled=true]:border-emerald-400 data-[filled=true]:bg-emerald-50/50"
      >
        <Icon name="file" class="size-7 text-brand-700" />
        <span data-cv-text class="text-sm font-medium text-slate-800">Drag your CV here or <span class="text-brand-700 underline">choose a file</span></span>
        <span class="text-xs text-slate-500">PDF or Word, up to 5 MB</span>
      </label>
      <p data-error-for="cv" class="mt-1 text-sm text-red-600" />
    </div>

    <div>
      <label class="label" for={`${id}-cover`}>Why are you a good fit? <span class="font-normal text-slate-500">(optional)</span></label>
      <textarea id={`${id}-cover`} name="cover_letter" rows="4" maxlength="3000" class="field py-2.5" placeholder="A few lines about your experience with certifications, labs or clients." />
    </div>

    <label class="flex items-start gap-2.5 text-sm text-slate-600">
      <input type="checkbox" name="consent" value="1" required class="mt-0.5 size-4 shrink-0 rounded border-slate-300 accent-brand-700" />
      <span>
        I agree to Instacertify using my details and CV to assess my application and contact me about it, as set out in the <a href="/privacy-policy" class="underline">Privacy Policy</a>.
        My CV is seen only by the hiring team and deleted after {retentionMonths} months; I can ask for it to be deleted sooner.
      </span>
    </label>
    <p data-error-for="consent" class="-mt-3 text-sm text-red-600" />
    <p data-error-for="vacancy" class="text-sm text-red-600" />

    <button type="submit" class="btn-primary w-full sm:w-auto">Submit application <Icon name="arrow-right" class="size-4" /></button>
    <p data-form-error role="alert" class="text-sm text-red-600" />
  </form>

  <div data-form-success hidden tabindex="-1" class="py-10 text-center outline-none">
    <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
      <Icon name="check-circle" class="size-8" />
    </div>
    <p class="mt-4 text-lg font-semibold text-slate-900">Application received — thank you!</p>
    <p class="mx-auto mt-1 max-w-md text-sm text-slate-600">Our team reviews every application. If your profile matches, we'll call or email you to set up a conversation.</p>
  </div>
</div>

<script>
  import '../scripts/careers';
</script>
