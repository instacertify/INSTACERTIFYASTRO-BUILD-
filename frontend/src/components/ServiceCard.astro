---
import Icon from './Icon.astro';
import MaterialIcon from './MaterialIcon.astro';
import { KINDS, REGIONS } from '../lib/content';
import type { Service } from '../lib/types';

interface Props {
  service: Service;
  compact?: boolean;
  /** Material Symbols icon shown beside the market label. */
  icon?: string | null;
  /** 2 when the cards sit directly under the page H1. */
  level?: 2 | 3;
}

const { service, compact = false, icon, level = 3 } = Astro.props;
const Heading = `h${level}` as const;
const tag = service.region ? REGIONS[service.region]?.label : KINDS[service.kind]?.short;
---

<a href={service.url} class="card-hover group flex h-full flex-col p-5">
  {(icon || tag) && (
    <p class="flex items-center gap-1.5 text-xs font-semibold text-slate-500">
      {icon && <MaterialIcon name={icon} class="size-5 text-brand-700" />}{tag}
    </p>
  )}
  <Heading class:list={['text-base font-bold text-slate-900 group-hover:text-brand-700', (icon || tag) && 'mt-2']}>{service.title}</Heading>
  {!compact && <p class="mt-2 line-clamp-3 text-sm leading-relaxed text-slate-600">{service.summary}</p>}
  <span class="mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold text-brand-700">
    Learn more <Icon name="arrow-right" class="size-4" />
  </span>
</a>
