---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import MaterialIcon from './MaterialIcon.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import CtaBand from './CtaBand.astro';
import { getServices, getSite, getTestCategories } from '../lib/content';
import { breadcrumbSchema, trailFor } from '../lib/breadcrumbs';
import { iconAlign, stackClass } from '../lib/iconAlign';
import type { Service } from '../lib/types';

interface Props {
  /** Industry slug; omitted for the Product testing overview with all industry tiles. */
  category?: string;
}

const { category: slug } = Astro.props;
const [site, all, categories] = await Promise.all([getSite(), getServices(), getTestCategories()]);
const tests = all.filter((s) => s.kind === 'testing');
const inCategory = (c: string) => tests.filter((s) => s.testCategories?.includes(c));
const category = slug ? categories.find((c) => c.slug === slug)! : null;

const path = category ? `services/testing/${category.slug}` : 'services/testing';
const trail = trailFor(path, category ? category.label : 'Product testing');

// Larger industries are grouped by test type (EMI/EMC, safety, RF, ...), biggest group first. A type with a
// single test here (often a test tagged with several industries) joins "Other tests", which always comes last.
const groupLabels = site.taxonomy?.groups ?? {};
const tileAlign = iconAlign(site.taxonomy?.testCategoryIconAlign);
const groups: [string, Service[]][] = [];
if (category) {
  const list = inCategory(category.slug);
  const size = (k: string) => list.filter((s) => s.group === k).length;
  const keyOf = (s: Service) => (list.length >= 8 && s.group && size(s.group) > 1 ? s.group : '');
  const keys = [...new Set(list.map(keyOf))].sort((a, b) =>
    a && b ? size(b) - size(a) || (groupLabels[a] ?? a).localeCompare(groupLabels[b] ?? b) : a ? -1 : b ? 1 : 0,
  );
  keys.forEach((k) => groups.push([k, list.filter((s) => keyOf(s) === k)]));
}
const count = category ? inCategory(category.slug).length : tests.length;

/** "Chemicals" → "Chemicals testing", but "Environmental & Water Testing" stays as it is. */
const named = (label: string) => (/testing$/i.test(label) ? label : `${label} testing`);
/** Legacy titles repeat their group ("Battery Testing Standards IEC 60896…" under Battery testing); the heading already says it. */
const tileTitle = (s: Service, grouped: boolean) => {
  if (!grouped) return s.title;
  const short = s.title.replace(/^(Battery Testing Standards|EMI EMC Standards|Environmental Testing|Safety Testing|Power Consumption Testing)\s*[-:–]?\s*/i, '');
  return short.length >= 4 ? short : s.title;
};

const title = category ? named(category.label) : 'Product testing by industry';
const description = category
  ? `${category.blurb} Tests are done at NABL-accredited and BIS-recognised partner labs.`
  : 'Pick your industry to see the tests we arrange at NABL-accredited and BIS-recognised partner labs, from electronics and IT equipment to food, cosmetics, toys and building materials.';

const jsonLd = [
  breadcrumbSchema(site.url, trail, path),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: title,
    itemListElement: category
      ? inCategory(category.slug).map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}${s.url}`, name: s.title }))
      : categories.map((c, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}/services/testing/${c.slug}`, name: named(c.label) })),
  },
];
---

<Layout title={`${title} | Instacertify`} description={description} jsonLd={jsonLd}>
  <section class="border-b border-slate-200 surface-tint">
    <div class="container-page py-8 sm:py-12">
      <Breadcrumbs items={trail} />
      <h1 class="mt-5 flex max-w-3xl items-center gap-3 text-[2rem] leading-tight font-bold sm:text-[2.5rem]">
        {category && <MaterialIcon name={category.icon} src={category.iconImage} class="size-9 shrink-0 text-brand-700 sm:size-11" />}{title}
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">{description}</p>
      {count > 0 && <p class="mt-3 text-sm font-semibold text-slate-500">{count} {count === 1 ? 'test' : 'tests'}{!category && ` across ${categories.length} industries`}</p>}
    </div>
  </section>

  {!category ? (
    <div class="container-page py-10 sm:py-14">
      <ul class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 lg:grid-cols-4">
        {categories.map((c) => {
          const n = inCategory(c.slug).length;
          return (
            <li>
              <a href={`/services/testing/${c.slug}`} class:list={['card-hover group flex h-full flex-col p-4 sm:p-5', stackClass[tileAlign]]}>
                <MaterialIcon name={c.icon} src={c.iconImage} class="size-9 text-brand-700 sm:size-10" />
                <span class="mt-4 flex-1 font-bold leading-snug hyphens-auto wrap-break-word text-slate-900 group-hover:text-brand-700">{c.label}</span>
                <span class="mt-2 text-sm text-slate-500">{n ? `${n} ${n === 1 ? 'test' : 'tests'}` : 'On request'}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ) : (
    <div class="container-page grid gap-10 py-10 sm:py-14 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-14">
      <div class="min-w-0 space-y-10">
        {groups.length === 0 && (
          <div class="max-w-2xl">
            <h2 class="text-xl section-title">We arrange {named(category.label)} on request</h2>
            <p class="mt-3 leading-relaxed text-slate-700">
              Send us the product and the standard you need to meet. We confirm the accredited lab, the list of tests, the cost and the turnaround time, usually within one business day.
            </p>
            <a href="/contact" class="btn-primary mt-6" data-track="quote">Ask about {named(category.label)} <Icon name="arrow-right" class="size-4" /></a>
          </div>
        )}
        {groups.map(([key, list]) => (
          <section aria-labelledby={`g-${key || 'general'}`}>
            {groups.length > 1
              ? <h2 id={`g-${key || 'general'}`} class="mb-4 flex items-baseline gap-2 text-xl section-title sm:text-2xl">{key ? groupLabels[key] ?? key : 'Other tests'}<span class="text-base font-semibold text-slate-500">{list.length}</span></h2>
              : <h2 id={`g-${key || 'general'}`} class="sr-only">{category.label} tests</h2>}
            <ul class="grid gap-4 sm:grid-cols-2">
              {list.map((s) => (
                <li>
                  <a href={s.url} class="card-hover group flex h-full flex-col p-5">
                    <span class="font-bold leading-snug text-slate-900 group-hover:text-brand-700">{tileTitle(s, Boolean(key) && groups.length > 1)}</span>
                    {s.summary && <span class="mt-2 line-clamp-3 flex-1 text-sm leading-relaxed text-slate-600">{s.summary}</span>}
                    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700">
                      View test <Icon name="arrow-right" class="size-4" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>

      <nav aria-labelledby="industries-h" class="self-start lg:sticky lg:top-24">
        <h2 id="industries-h" class="text-base font-bold text-slate-950">Other industries</h2>
        <ul class="mt-3 divide-y divide-slate-100 border-y border-slate-200">
          {categories.filter((c) => c.slug !== category.slug).map((c) => (
            <li>
              <a href={`/services/testing/${c.slug}`} class="flex items-center gap-2.5 py-2 text-base text-slate-700 hover:text-brand-700">
                <MaterialIcon name={c.icon} src={c.iconImage} class="size-5 shrink-0 text-slate-400" />{c.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )}

  <CtaBand
    title={category ? `Need ${named(category.label)}?` : 'Not sure which tests your product needs?'}
    text="Tell us the product and where you sell it. We reply with the standard, the tests, the accredited lab, the cost and the turnaround time."
  />
</Layout>
