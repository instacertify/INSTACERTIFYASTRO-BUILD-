---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { KINDS, POST_TYPES, getEvents, getIndustries, getPages, getPosts, getServices, getSite, getStandardCategories, listings } from '../lib/content';
import { breadcrumbSchema } from '../lib/breadcrumbs';
import type { PostType } from '../lib/types';

interface Props {
  /** Both /sitemap and /html-sitemap are indexed on the live site, so each keeps its own title and canonical. */
  title: string;
  describe: (total: number) => string;
}

const { title, describe } = Astro.props;
const [services, industries, pages, standardCategories, events, ...posts] = await Promise.all([
  getServices(),
  getIndustries(),
  getPages(),
  getStandardCategories(),
  getEvents(),
  ...(Object.keys(POST_TYPES) as PostType[]).map((t) => getPosts(t)),
]);

type Link = { href: string; label: string };
const byLabel = (a: Link, b: Link) => a.label.localeCompare(b.label);

const groups: { title: string; links: Link[] }[] = [
  {
    title: 'Company',
    links: [
      { href: '/', label: 'Home' },
      { href: '/services', label: 'All services' },
      { href: '/industries', label: 'Industries' },
      { href: '/resources', label: 'Resources' },
      { href: '/faq', label: 'FAQ' },
      { href: '/careers', label: 'Careers' },
      { href: '/contact', label: 'Contact' },
      ...pages.filter((p) => p.template !== 'landing' && !p.seo?.robots?.startsWith('noindex')).map((p) => ({ href: p.url, label: p.title })),
    ],
  },
  { title: 'Service categories', links: listings().map((l) => ({ href: `/${l.path}`, label: l.title })) },
  ...Object.entries(KINDS).map(([kind, meta]) => ({
    title: meta.label,
    links: services.filter((s) => s.kind === kind).map((s) => ({ href: s.url, label: s.title })).sort(byLabel),
  })),
  { title: 'Landing pages', links: pages.filter((p) => p.template === 'landing').map((p) => ({ href: p.url, label: p.title })).sort(byLabel) },
  { title: 'Industries', links: industries.map((i) => ({ href: i.url, label: i.name })) },
  {
    title: 'Standards library',
    links: [
      { href: '/resources/standards', label: 'All standards' },
      ...standardCategories.map((c) => ({ href: c.url, label: `${c.title} (${c.standards.length.toLocaleString('en-IN')})` })),
    ],
  },
  ...(Object.entries(POST_TYPES) as [PostType, (typeof POST_TYPES)[PostType]][]).map(([, meta], i) => ({
    title: meta.plural,
    links: [{ href: `/${meta.listPath}`, label: `All ${meta.plural.toLowerCase()}` }, ...posts[i].map((p) => ({ href: p.url, label: p.title }))],
  })),
  { title: 'Events', links: [{ href: '/resources/events', label: 'All events' }, ...events.map((e) => ({ href: e.url, label: e.title }))] },
].filter((g) => g.links.length);

const total = groups.reduce((n, g) => n + g.links.length, 0);
const site = await getSite();
const trail = [{ label: 'Sitemap' }];
const path = Astro.url.pathname.replace(/^\/|\.html$|\/$/g, '');
---

<Layout title={title} description={describe(total)} jsonLd={[breadcrumbSchema(site.url, trail, path)]}>
  <section class="border-b border-slate-200 surface-tint">
    <div class="container-page py-8 sm:py-12">
      <Breadcrumbs items={trail} />
      <h1 class="mt-5 text-[2rem] leading-tight font-bold sm:text-[2.5rem]">Explore the entire site</h1>
      <nav aria-label="Sitemap sections" class="mt-6 flex flex-wrap gap-2">
        {groups.map((g, i) => <a href={`#s${i}`} class="inline-flex min-h-9 items-center rounded-full border border-slate-200 bg-white px-3.5 text-sm text-slate-700 hover:border-brand-300">{g.title} <span class="ml-1.5 opacity-75">{g.links.length}</span></a>)}
      </nav>
    </div>
  </section>

  <div class="container-page space-y-12 py-10 sm:py-14">
    {groups.map((g, i) => (
      <section id={`s${i}`} aria-labelledby={`s${i}-h`} class="scroll-mt-24">
        <h2 id={`s${i}-h`} class="text-xl section-title sm:text-2xl">{g.title}</h2>
        <ul class="mt-3 grid gap-x-8 text-base sm:grid-cols-2 lg:grid-cols-3">
          {g.links.map((l) => <li><a href={l.href} class="inline-block py-1 text-slate-700 hover:text-brand-700 hover:underline">{l.label}</a></li>)}
        </ul>
      </section>
    ))}
  </div>
</Layout>
