---
import Icon from './Icon.astro';
import { initials, type Review } from '../lib/reviews';

interface Props {
  t: Review;
  large?: boolean;
  class?: string;
}

const { t, large = false, class: className } = Astro.props;
---

<figure class:list={['card flex flex-col', large ? 'p-5 sm:p-6' : 'p-6', className]}>
  <div class="flex gap-0.5 text-amber-400" role="img" aria-label={`${t.rating} out of 5 stars`} data-stars>
    {Array.from({ length: t.rating }).map(() => <Icon name="star" class="size-4" />)}
  </div>
  <blockquote class:list={['mt-4 flex-1 leading-relaxed text-slate-700', !large && 'text-base']} data-quote>“{t.quote}”</blockquote>
  <figcaption class="mt-5 flex items-center gap-3 border-t border-slate-100 pt-4">
    <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-100 text-sm font-semibold text-brand-700" aria-hidden="true" data-initials>
      {initials(t.name)}
    </span>
    <span>
      <span class:list={['block font-semibold text-slate-900', large ? 'text-base' : 'text-sm']} data-name>{t.name}</span>
      <span class:list={['block text-slate-500', large ? 'text-sm' : 'text-xs']} data-context>{t.context}</span>
    </span>
  </figcaption>
</figure>
