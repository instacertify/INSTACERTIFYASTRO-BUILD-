---
import Icon from './Icon.astro';
import type { Service } from '../lib/types';

interface Props {
  id: string;
  variant?: 'compact' | 'full';
  servicePath?: string;
  services?: Service[];
  title?: string;
  subtitle?: string;
  /** Compact variant only: lay the fields out two per row (for wide containers). */
  grid?: boolean;
  button?: string;
  /** Drop the card chrome when the form sits inside another container (e.g. a dialog). */
  bare?: boolean;
  /** Centred uppercase title, for sidebars. */
  caps?: boolean;
  /** Compact variant only: phone alone is enough to submit. */
  emailOptional?: boolean;
  successText?: string;
  /** Compact variant only: classes for the submit button. */
  buttonClass?: string;
  /** Page to open once the enquiry is sent, instead of the inline thank-you. */
  redirect?: string;
  /** Compact variant only: the larger form at the top of a landing page, name and phone side by side. */
  hero?: boolean;
  /** Hero only: tighter padding and a lighter title. */
  compact?: boolean;
}

const {
  id,
  variant = 'compact',
  servicePath,
  services = [],
  title = 'Talk to a specialist',
  subtitle = 'Free assessment. We reply within 1 business day.',
  grid = false,
  button = 'Get free assessment',
  bare = false,
  caps = false,
  emailOptional = false,
  buttonClass = 'btn-primary',
  successText = 'A certification specialist will contact you within 1 business day, usually much sooner.',
  redirect,
  hero = false,
  compact = false,
} = Astro.props;

const full = variant === 'full';
const requirements = { testing: 'Testing', certification: 'Certification', inspection: 'Inspection', other: 'Other' };
const requirementFor = (s: Service) => (s.kind === 'testing' ? 'testing' : /inspection/i.test(s.path) ? 'inspection' : 'certification');
// Lets "/contact?service=…" links keep the service and pre-pick what the visitor needs.
const serviceRequirements = full && services.length ? JSON.stringify(Object.fromEntries(services.map((s) => [s.path, requirementFor(s)]))) : undefined;
const presetRequirement = services.find((s) => s.path === servicePath);
---

<div
  class:list={[
    'relative',
    !bare && 'card',
    !bare && (full ? 'p-6 sm:p-8' : hero ? ['rounded-[1.25rem] border-white shadow-[0_30px_60px_-24px_rgb(0_0_0/0.5)]', compact ? 'p-5 sm:p-6' : 'p-6 sm:p-7'] : 'rounded-[1.25rem] p-5 shadow-[0_8px_28px_rgb(0_0_0/0.06)] sm:p-6'),
  ]}
>
  <form data-lead-form={id} data-service-requirements={serviceRequirements} data-redirect={redirect} novalidate={false} class:list={[hero && !compact ? 'space-y-5' : 'space-y-4']}>
    <div class:list={[caps && 'text-center', hero && ['border-b border-slate-100', compact ? 'pb-4' : 'pb-5']]}>
      <p class:list={['text-slate-900', bare && 'pr-9', caps ? 'text-lg leading-snug font-bold tracking-[0.04em] uppercase sm:text-xl' : hero ? ['leading-tight tracking-[-0.01em] text-slate-950', compact ? 'text-xl font-semibold' : 'text-[1.375rem] font-bold'] : 'text-lg font-bold']}>{title}</p>
      {subtitle && <p class:list={[hero ? 'mt-2 leading-relaxed text-slate-600' : 'mt-1 text-sm text-slate-500']}>{subtitle}</p>}
    </div>

    <input type="hidden" name="type" value={full ? 'quote' : 'consultation'} />
    {servicePath && !full && <input type="hidden" name="service_path" value={servicePath} />}
    <div class="absolute -left-[9999px]" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    {full ? (
      <>
        <ol class="flex items-center gap-2 text-xs font-medium text-slate-500" aria-label="Form progress">
          <li class="flex items-center gap-2">
            <span data-step-indicator="1" data-active="true" class="flex size-6 items-center justify-center rounded-full bg-slate-200 text-slate-600 data-[active=true]:bg-brand-700 data-[active=true]:text-white">1</span>
            Your requirement
          </li>
          <li class="h-px w-6 bg-slate-300" aria-hidden="true" />
          <li class="flex items-center gap-2">
            <span data-step-indicator="2" data-active="false" class="flex size-6 items-center justify-center rounded-full bg-slate-200 text-slate-600 data-[active=true]:bg-brand-700 data-[active=true]:text-white">2</span>
            Contact details
          </li>
        </ol>

        <fieldset data-step="1" class="space-y-4">
          <legend class="sr-only">Your requirement</legend>
          <div>
            <label class="label" for={`${id}-requirement`}>What do you need?</label>
            <select id={`${id}-requirement`} name="requirement" class="field" required>
              <option value="">Select one</option>
              {Object.entries(requirements).map(([value, label]) => (
                <option value={value} selected={presetRequirement && requirementFor(presetRequirement) === value}>{label}</option>
              ))}
            </select>
            <p data-error-for="requirement" class="mt-1 text-sm text-red-600 empty:hidden" />
            <input type="hidden" name="service_path" value={servicePath ?? ''} />
          </div>
          <div>
            <label class="label" for={`${id}-product`}>Product</label>
            <input id={`${id}-product`} name="product" class="field" placeholder="e.g. 20W USB-C charger" maxlength="190" />
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for={`${id}-mtype`}>You are a</label>
              <select id={`${id}-mtype`} name="manufacturer_type" class="field">
                <option value="indian">Indian manufacturer</option>
                <option value="foreign">Foreign manufacturer</option>
                <option value="importer">Importer / brand owner</option>
                <option value="other">Other</option>
              </select>
            </div>
            <div>
              <label class="label" for={`${id}-timeline`}>Timeline</label>
              <select id={`${id}-timeline`} name="timeline" class="field">
                <option value="urgent">Urgent (under 1 month)</option>
                <option value="1-3-months" selected>1–3 months</option>
                <option value="3-6-months">3–6 months</option>
                <option value="exploring">Just exploring</option>
              </select>
            </div>
          </div>
          <button type="button" class="btn-primary w-full" data-next>
            Continue <Icon name="arrow-right" class="size-4" />
          </button>
        </fieldset>

        <fieldset data-step="2" class="space-y-4" hidden>
          <legend class="sr-only">Contact details</legend>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="label" for={`${id}-name`}>Full name</label>
              <input id={`${id}-name`} name="name" class="field" autocomplete="name" required minlength="2" />
              <p data-error-for="name" class="mt-1 text-sm text-red-600 empty:hidden" />
            </div>
            <div>
              <label class="label" for={`${id}-company`}>Company</label>
              <input id={`${id}-company`} name="company" class="field" autocomplete="organization" />
            </div>
            <div>
              <label class="label" for={`${id}-phone`}>Phone / WhatsApp</label>
              <input id={`${id}-phone`} name="phone" type="tel" class="field" autocomplete="tel" inputmode="tel" required pattern="\+?[0-9 \-]{8,20}" title="Mobile number with country code, e.g. +91 98765 43210" placeholder="+91 98xxx xxxxx" />
              <p data-error-for="phone" class="mt-1 text-sm text-red-600 empty:hidden" />
            </div>
            <div>
              <label class="label" for={`${id}-email`}>Work email</label>
              <input id={`${id}-email`} name="email" type="email" class="field" autocomplete="email" required placeholder="you@company.com" />
              <p data-error-for="email" class="mt-1 text-sm text-red-600 empty:hidden" />
            </div>
          </div>
          <div>
            <label class="label" for={`${id}-message`}>Anything else? <span class="font-normal text-slate-500">(optional)</span></label>
            <textarea id={`${id}-message`} name="message" rows="3" class="field py-2.5" maxlength="3000" placeholder="Models, target markets, deadlines…" />
          </div>
          <label class="flex items-start gap-2.5 text-sm text-slate-600">
            <input type="checkbox" name="consent" value="1" required class="mt-0.5 size-4 rounded border-slate-300 accent-brand-700" />
            <span>I agree to Instacertify using these details to contact me about this enquiry, as set out in the <a href="/privacy-policy" class="underline">Privacy Policy</a>. I can withdraw consent anytime.</span>
          </label>
          <p data-error-for="consent" class="text-sm text-red-600 empty:hidden" />
          <label class="flex items-start gap-2.5 text-sm text-slate-600">
            <input type="checkbox" name="marketing_opt_in" value="1" class="mt-0.5 size-4 rounded border-slate-300 accent-brand-700" />
            <span>Also send me occasional regulatory updates (optional).</span>
          </label>
          <p class="text-xs text-slate-500">We record your IP address with your enquiry to block spam and as proof of your consent.</p>
          <div class="flex gap-3">
            <button type="button" class="btn-ghost" data-back>Back</button>
            <button type="submit" class="btn-primary flex-1">Get my free quote</button>
          </div>
        </fieldset>
      </>
    ) : (
      <>
        <div class:list={[grid || hero ? 'grid gap-4 sm:grid-cols-2' : 'space-y-4']}>
          <div>
            <label class="label" for={`${id}-name`}>Name</label>
            <input id={`${id}-name`} name="name" class="field" autocomplete="name" required minlength="2" placeholder="Your full name" />
            <p data-error-for="name" class="mt-1 text-sm text-red-600 empty:hidden" />
          </div>
          <div>
            <label class="label" for={`${id}-phone`}>Phone / WhatsApp</label>
            <input id={`${id}-phone`} name="phone" type="tel" class="field" autocomplete="tel" inputmode="tel" required pattern="\+?[0-9 \-]{8,20}" title="Mobile number with country code, e.g. +91 98765 43210" placeholder="+91 98xxx xxxxx" />
            <p data-error-for="phone" class="mt-1 text-sm text-red-600 empty:hidden" />
          </div>
          <div class:list={[hero && 'sm:col-span-2']}>
            <label class="label" for={`${id}-email`}>Email{emailOptional && <span class="font-normal text-slate-500"> (optional)</span>}</label>
            <input id={`${id}-email`} name="email" type="email" class="field" autocomplete="email" required={!emailOptional} placeholder="you@company.com" />
            <p data-error-for="email" class="mt-1 text-sm text-red-600 empty:hidden" />
          </div>
          <div class:list={[hero && 'sm:col-span-2']}>
            <label class="label" for={`${id}-product`}>Product or requirement</label>
            <input id={`${id}-product`} name="product" class="field" maxlength="190" placeholder="e.g. Bluetooth speaker, BIS + WPC" />
          </div>
        </div>
        <div class:list={['space-y-1.5 text-slate-600', hero ? 'text-[0.8125rem] leading-snug' : 'text-xs']}>
          <label class="flex min-h-6 items-start gap-2">
            <input type="checkbox" name="consent" value="1" required class="mt-px size-4 shrink-0 rounded border-slate-300 accent-brand-700" />
            <span>I agree to be contacted about this enquiry as per the <a href="/privacy-policy" class="underline">Privacy Policy</a>.</span>
          </label>
          <p data-error-for="consent" class="text-red-600 empty:hidden" />
          <label class="flex min-h-6 items-start gap-2">
            <input type="checkbox" name="marketing_opt_in" value="1" class="mt-px size-4 shrink-0 rounded border-slate-300 accent-brand-700" />
            <span>Send me occasional regulatory updates (optional).</span>
          </label>
        </div>
        <button type="submit" class:list={[buttonClass, 'w-full']}>{button} <Icon name="arrow-right" class="size-4" /></button>
        <p class:list={['flex items-center justify-center gap-1.5 text-center text-slate-500', hero ? 'text-[0.8125rem]' : 'text-xs']}><Icon name="shield" class="size-3.5 shrink-0" />Your details stay private. We log your IP to block spam.</p>
      </>
    )}

    <p data-form-error role="alert" class="text-sm text-red-600 empty:hidden data-[success=true]:text-emerald-700" />
  </form>

  <div data-form-success hidden tabindex="-1" class="py-8 text-center outline-none">
    <div class="mx-auto flex size-14 items-center justify-center rounded-full bg-emerald-50 text-emerald-600">
      <Icon name="check-circle" class="size-8" />
    </div>
    <p class="mt-4 text-lg font-semibold text-slate-900">Thank you — we've got it.</p>
    <p class="mt-1 text-sm text-slate-600">{successText}</p>
    <a href="https://wa.me/919999118039" class="btn-whatsapp mt-5" target="_blank" rel="noopener"><Icon name="whatsapp" class="size-5" />Need it faster? WhatsApp us</a>
  </div>
</div>

<script>
  import '../scripts/leads';
</script>
