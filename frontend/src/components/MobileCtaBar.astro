---
import Icon from './Icon.astro';
import type { Site } from '../lib/types';

interface Props {
  site: Site;
  /** Scroll to a form on the page instead of opening the quote dialog. */
  quoteHref?: string;
  whatsappText?: string;
}

const { site, quoteHref, whatsappText = 'Hi Instacertify, I need help with a certification.' } = Astro.props;
const waText = encodeURIComponent(whatsappText);
---

<div class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-3 border-t border-slate-200 bg-white pb-[env(safe-area-inset-bottom)] shadow-[0_-4px_16px_rgba(15,23,42,0.06)] lg:hidden">
  <a href={`tel:${site.contact.phoneE164}`} class="flex h-16 flex-col items-center justify-center gap-0.5 text-xs font-medium text-slate-700" data-track="call">
    <Icon name="phone" class="size-5 text-brand-700" />Call
  </a>
  <a href={`https://wa.me/${site.contact.whatsapp}?text=${waText}`} target="_blank" rel="noopener" class="flex h-16 flex-col items-center justify-center gap-0.5 text-xs font-medium text-slate-700" data-track="whatsapp">
    <Icon name="whatsapp" class="size-5 text-[#128C4B]" />WhatsApp
  </a>
  <a href={quoteHref ?? '/contact'} class="flex h-16 flex-col items-center justify-center gap-0.5 bg-cta text-xs font-semibold text-white" data-track="quote" data-open-lead={quoteHref ? undefined : ''}>
    <Icon name="file" class="size-5" />Free quote
  </a>
</div>

<a
  href={`https://wa.me/${site.contact.whatsapp}?text=${waText}`}
  target="_blank"
  rel="noopener"
  class="fixed right-6 bottom-6 z-40 hidden size-14 items-center justify-center rounded-full bg-[#128C4B] text-white shadow-lg shadow-emerald-900/20 transition-colors hover:bg-[#0e733d] lg:flex"
  aria-label="Chat on WhatsApp"
  data-track="whatsapp"
>
  <Icon name="whatsapp" class="size-7" />
</a>
