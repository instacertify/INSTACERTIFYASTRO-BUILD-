<script>
  // Highlights the tab of the section currently in view.
  const tabs = document.querySelector<HTMLElement>('[data-tabs]');
  if (tabs) {
    const links = [...tabs.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
    const sections = links.map((a) => document.getElementById(a.dataset.tab!)).filter((s): s is HTMLElement => !!s);
    let currentId = '';
    const activate = (id: string) => {
      if (id === currentId) return;
      currentId = id;
      links.forEach((a) => (a.dataset.tab === id ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      const active = links.find((a) => a.dataset.tab === id);
      if (!active) return;
      const left = active.getBoundingClientRect().left - tabs.getBoundingClientRect().left + tabs.scrollLeft;
      tabs.scrollTo({ left: left - 40, behavior: 'smooth' });
    };
    const fade = () => {
      const max = tabs.scrollWidth - tabs.clientWidth;
      tabs.dataset.fade = max <= 1 ? '' : tabs.scrollLeft <= 1 ? 'end' : tabs.scrollLeft >= max - 1 ? 'start' : 'both';
    };
    tabs.addEventListener('scroll', fade, { passive: true });
    addEventListener('resize', fade);
    fade();
    const update = () => {
      const line = 170;
      let current = sections[0];
      for (const s of sections) if (s.getBoundingClientRect().top <= line) current = s;
      // A short last section never reaches the line, so the page bottom selects it.
      const last = sections.at(-1);
      if (last && innerHeight + scrollY >= document.documentElement.scrollHeight - 2 && last.getBoundingClientRect().top < innerHeight) current = last;
      if (current) activate(current.id);
    };
    links.forEach((a) => a.addEventListener('click', () => activate(a.dataset.tab!)));
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
