---
import Icon from './Icon.astro';
import ConsentText from './ConsentText.astro';
import { getContactBoxes, getServices } from '../lib/content';
import { CONSULTING_NOTE, ISI_OTHER_CHARGES } from '../lib/standards';
import type { LandingPageRecord, Site } from '../lib/types';

type Finder = NonNullable<NonNullable<LandingPageRecord['content']>['finder']>;

interface Props {
  finder: Finder;
  site: Site;
  /** Lead service when the product-specific one is missing. */
  servicePath?: string | null;
}

const { finder, site, servicePath } = Astro.props;
const [services, boxes] = await Promise.all([getServices(), getContactBoxes()]);
const known = new Set(services.map((s) => s.path));
const words = boxes.feeFinder;
const pick = (path: string) => (known.has(path) ? path : servicePath ?? '');

const amount = (value: unknown, fallback: number) => Number(value) || fallback;
const config = {
  crs: [amount(finder.crs_fee_micro, 7000), amount(finder.crs_fee_small, 14500), amount(finder.crs_fee_medium, 27000), amount(finder.crs_fee_large, 27000)],
  crsTest: amount(finder.crs_test_from, 20000),
  isiOther: {
    application: amount(finder.isi_application_fee, ISI_OTHER_CHARGES.application),
    licence: amount(finder.isi_licence_fee, ISI_OTHER_CHARGES.licence),
    audit: amount(finder.isi_audit_fee, ISI_OTHER_CHARGES.audit),
  },
  consulting: finder.consulting_note || CONSULTING_NOTE,
  whatsapp: site.contact.whatsapp,
  services: {
    crs: pick('certification/india/bis-crs-mark-certification'),
    isi: pick('certification/india/bis-isi-mark-domestic-manufacturers'),
  },
};
const suggestions = finder.suggestions?.length ? finder.suggestions : ['LED lamp', 'Power bank', 'Pressure cooker', 'Helmet', 'Toys', 'Steel'];
const modes = [
  { id: 'name', label: 'Product name', placeholder: 'e.g. LED lamp, pressure cooker, helmet', inputmode: 'search' },
  { id: 'is', label: 'IS number', placeholder: 'e.g. IS 302 or 16046', inputmode: 'search' },
  { id: 'hsn', label: 'HSN code', placeholder: 'e.g. 8516 or 85044030', inputmode: 'numeric' },
];
const scales = [
  { id: 'micro', label: 'Micro', hint: 'Up to ₹10 cr' },
  { id: 'small', label: 'Small', hint: 'Up to ₹100 cr' },
  { id: 'medium', label: 'Medium', hint: 'Up to ₹500 cr' },
  { id: 'large', label: 'Large', hint: 'Above ₹500 cr' },
];
const segment = 'flex min-h-11 items-center justify-center rounded-lg px-2 text-center text-sm font-semibold text-slate-600 peer-checked:bg-white peer-checked:text-brand-700 peer-checked:shadow-sm peer-focus-visible:outline-2 peer-focus-visible:outline-brand-700';
const tile = 'flex cursor-pointer flex-col rounded-xl border border-slate-300 px-3 py-2.5 has-checked:border-brand-700 has-checked:bg-brand-50 has-checked:ring-1 has-checked:ring-brand-700 has-focus-visible:outline-2 has-focus-visible:outline-brand-700';
---

<section id="bis-fees" class="border-b border-slate-200 py-8 surface-tint sm:py-10 lg:py-12" data-finder data-config={JSON.stringify(config)}>
  <div class="container-page">
    <div class="max-w-2xl">
      <h2 class="text-2xl leading-tight font-semibold tracking-[-0.015em] text-balance text-slate-950 sm:text-[1.75rem] lg:text-[1.875rem]">{finder.heading || 'Check the BIS fee for your product'}</h2>
      <p class="mt-2.5 text-base leading-relaxed text-slate-600 sm:text-lg sm:leading-relaxed">{finder.intro || 'Search by product name, IS number or HSN code to see the BIS fee and when it became mandatory.'}</p>
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-4 shadow-[0_8px_24px_rgb(0_0_0/0.04)] sm:p-5">
      <form role="search" data-finder-form class="space-y-4">
        <fieldset>
          <legend class="text-sm font-semibold text-slate-700">Search by</legend>
          <div class="mt-2 grid grid-cols-3 gap-1 rounded-xl bg-slate-100 p-1 sm:max-w-lg">
            {modes.map((m, i) => (
              <label class="cursor-pointer">
                <input type="radio" name="mode" value={m.id} checked={i === 0} class="peer sr-only" data-placeholder={m.placeholder} data-inputmode={m.inputmode} />
                <span class={segment}>{m.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <div class="relative">
          <label for="finder-q" class="sr-only">Search products</label>
          <Icon name="search" class="pointer-events-none absolute top-1/2 left-4 size-5 -translate-y-1/2 text-slate-400" />
          <input id="finder-q" name="q" type="search" class="block min-h-14 w-full rounded-xl border border-slate-300 bg-white pr-12 pl-12 text-lg text-slate-900 placeholder:text-slate-400 focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 focus:outline-none [&::-webkit-search-cancel-button]:hidden" placeholder={modes[0].placeholder} autocomplete="off" enterkeyhint="search" maxlength="80" />
          <button type="button" data-clear hidden class="absolute top-1/2 right-2 flex size-10 -translate-y-1/2 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900" aria-label="Clear search">
            <Icon name="x" class="size-5" />
          </button>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
          <p class="text-sm text-slate-600">
            Popular:{' '}
            {suggestions.map((s, i) => (
              <>
                {i > 0 && <span aria-hidden="true" class="text-slate-300"> · </span>}
                <button type="button" data-suggest class="-my-1 py-1 font-medium text-brand-700 underline decoration-brand-200 underline-offset-4 hover:decoration-brand-700">{s}</button>
              </>
            ))}
          </p>
          <fieldset class="flex items-center gap-2 text-sm">
            <legend class="sr-only">Certification</legend>
            <span aria-hidden="true" class="font-semibold text-slate-700">Show</span>
            <div class="grid grid-cols-3 gap-1 rounded-xl bg-slate-100 p-1">
              {[['all', 'All'], ['isi', 'ISI mark'], ['crs', 'CRS']].map(([value, label], i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="scheme" value={value} checked={i === 0} class="peer sr-only" />
                  <span class:list={[segment, 'min-h-9 px-3']}>{label}</span>
                </label>
              ))}
            </div>
          </fieldset>
        </div>
      </form>

      <p data-count aria-live="polite" class="mt-5 text-sm font-medium text-slate-600 empty:hidden"></p>
      <ul data-results class="mt-2 divide-y divide-slate-200 border-t border-slate-200" hidden></ul>
      <button type="button" data-more hidden class="btn-ghost mt-4 w-full">Show more products</button>
      <div data-empty hidden class="mt-4 border-t border-slate-200 pt-5 text-slate-700">
        <p>No product matches <strong data-empty-q></strong> in this list.</p>
        <p class="mt-1">
          {words.noMatch}{' '}
          <a href="#quote" data-ask data-focus-quote class="font-semibold text-accent-600 underline underline-offset-4 hover:text-accent-700">{words.ask}</a>
        </p>
      </div>
    </div>
  </div>

  <template data-row>
    <li class="grid gap-3 py-4 sm:grid-cols-[1fr_auto] sm:items-center sm:gap-6">
      <div class="min-w-0">
        <p class="font-semibold text-slate-950" data-name></p>
        <p class="mt-1 flex flex-wrap gap-x-3 gap-y-0.5 text-sm text-slate-600">
          <span data-scheme class="font-semibold text-brand-700"></span>
          <span data-is></span>
          <span data-hsn></span>
        </p>
        <p class="mt-1.5 flex items-center gap-1.5 text-sm text-slate-700"><Icon name="calendar" class="size-4 shrink-0 text-slate-400" /><span data-when></span></p>
      </div>
      <div class="flex items-center justify-between gap-4 sm:justify-end">
        <p class="text-sm leading-tight text-slate-600 sm:text-right"><span data-fee-label>BIS fee</span><span class="block text-lg font-semibold whitespace-nowrap text-slate-950" data-fee></span></p>
        <button type="button" class="btn-primary min-h-11 shrink-0" data-explore>Explore this product<Icon name="arrow-right" class="size-4" /></button>
      </div>
    </li>
  </template>

  <dialog
    id="fee-dialog"
    aria-labelledby="fee-title"
    class="m-0 mt-auto max-h-[92dvh] w-full max-w-none overflow-y-auto rounded-t-3xl bg-white p-0 shadow-2xl backdrop:bg-slate-950/60 sm:m-auto sm:max-w-xl sm:rounded-3xl"
  >
    <div class="relative p-5 pb-[max(1.25rem,env(safe-area-inset-bottom))] sm:p-7">
      <button type="button" data-close class="absolute top-3 right-3 flex size-10 items-center justify-center rounded-full text-slate-500 hover:bg-slate-100 hover:text-slate-900" aria-label="Close">
        <Icon name="x" class="size-5" />
      </button>
      <p class="pr-10 text-sm font-semibold text-brand-700" data-d-scheme></p>
      <h3 id="fee-title" class="mt-1 pr-10 text-xl leading-snug font-semibold text-slate-950" data-d-name></h3>
      <p class="mt-1 text-sm text-slate-600" data-d-meta></p>

      <form data-lead-form="fee-finder" class="mt-5 space-y-4">
        <p class="border-l-4 border-brand-700 bg-brand-50 px-4 py-3 text-sm text-brand-700">{words.gateText}</p>
        <input type="hidden" name="type" value="consultation" />
        <input type="hidden" name="requirement" value="certification" />
        <input type="hidden" name="product" />
        <input type="hidden" name="service_path" />
        <input type="hidden" name="manufacturer_type" />
        <input type="hidden" name="message" />
        <div class="absolute -left-[9999px]" aria-hidden="true">
          <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <fieldset>
          <legend class="label">Your business</legend>
          <div class="grid grid-cols-2 gap-2 sm:grid-cols-4">
            {scales.map((s) => (
              <label class={tile}>
                <input type="radio" name="scale" value={s.id} required class="sr-only" />
                <span class="text-sm font-semibold text-slate-900">{s.label}</span>
                <span class="text-xs text-slate-500">{s.hint}</span>
              </label>
            ))}
            <label class:list={[tile, 'col-span-2 sm:col-span-4']}>
              <input type="radio" name="scale" value="foreign" required class="sr-only" />
              <span class="text-sm font-semibold text-slate-900">Foreign manufacturer</span>
              <span class="text-xs text-slate-500">Factory outside India</span>
            </label>
          </div>
          <p class="mt-1.5 text-xs text-slate-500">{words.turnoverHint}</p>
        </fieldset>

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="label" for="fee-name">Name</label>
            <input id="fee-name" name="name" class="field" autocomplete="name" required minlength="2" placeholder={boxes.form.namePlaceholder} />
            <p data-error-for="name" class="mt-1 text-sm text-red-600" />
          </div>
          <div>
            <label class="label" for="fee-phone">Phone / WhatsApp</label>
            <input id="fee-phone" name="phone" type="tel" class="field" autocomplete="tel" inputmode="tel" required pattern="\+?[0-9 \-]{8,20}" title="Mobile number with country code, e.g. +91 98765 43210" placeholder={boxes.form.phonePlaceholder} />
            <p data-error-for="phone" class="mt-1 text-sm text-red-600" />
          </div>
          <div class="sm:col-span-2">
            <label class="label" for="fee-email">Email <span class="font-normal text-slate-500">(optional)</span></label>
            <input id="fee-email" name="email" type="email" class="field" autocomplete="email" placeholder={boxes.form.emailPlaceholder} />
            <p data-error-for="email" class="mt-1 text-sm text-red-600" />
          </div>
        </div>
        <label class="flex min-h-6 items-start gap-2 text-xs text-slate-600">
          <input type="checkbox" name="consent" value="1" required class="mt-px size-4 shrink-0 rounded border-slate-300 accent-brand-700" />
          <ConsentText text={boxes.form.consent} />
        </label>
        <p data-error-for="consent" class="text-xs text-red-600" />
        <button type="submit" class="btn-primary min-h-13 w-full text-base font-semibold">{words.button}<Icon name="arrow-right" class="size-4" /></button>
        <p data-form-error role="alert" class="text-sm text-red-600 data-[success=true]:text-emerald-700" />
      </form>

      <div data-fee-result hidden class="mt-5">
        <p data-thanks hidden class="mb-4 flex items-start gap-2 text-sm font-medium text-emerald-700">
          <Icon name="check-circle" class="mt-px size-4 shrink-0" />{words.thanks}
        </p>
        <fieldset>
          <legend class="label">Your business</legend>
          <div class="grid grid-cols-5 gap-1 rounded-xl bg-slate-100 p-1">
            {[...scales, { id: 'foreign', label: 'Foreign' }].map((s) => (
              <label class="cursor-pointer">
                <input type="radio" name="view-scale" value={s.id} class="peer sr-only" />
                <span class:list={[segment, 'px-1']}>{s.label}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <dl class="mt-4 divide-y divide-slate-200 border-y border-slate-200 text-base">
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-slate-600">When</dt>
            <dd class="text-right font-semibold text-slate-950" data-r-when></dd>
          </div>
          <div class="py-3">
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-slate-600" data-r-fee-label></dt>
              <dd class="text-right text-lg font-semibold text-slate-950" data-r-fee></dd>
            </div>
            <p class="mt-1 text-sm text-slate-500" data-r-fee-note></p>
          </div>
          <div class="py-3" data-r-other-row>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-slate-600">Other BIS charges</dt>
              <dd class="text-right font-semibold text-slate-950" data-r-other></dd>
            </div>
            <p class="mt-1 text-sm text-slate-500 empty:hidden" data-r-other-note></p>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-slate-600">Lab testing</dt>
            <dd class="text-right font-semibold text-slate-950" data-r-test></dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-slate-600">Our consulting fee</dt>
            <dd class="text-right font-semibold text-brand-700" data-r-consulting></dd>
          </div>
        </dl>
        <p class="mt-3 text-xs text-slate-500">{words.disclaimer}</p>
        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <a data-r-wa href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener" class="btn-whatsapp min-h-12 font-semibold" data-track="whatsapp"><Icon name="whatsapp" class="size-5" />{words.whatsapp}</a>
          <a href={`tel:${site.contact.phoneE164}`} class="btn-ghost min-h-12 font-semibold" data-track="call"><Icon name="phone" class="size-5" />{site.contact.phone}</a>
        </div>
      </div>
    </div>
  </dialog>
</section>

<script>
  import { track } from '../scripts/leads';
  import { prefStorage } from '../scripts/consent';
  import { rupees } from '../lib/standards';
  import type { FinderProduct } from '../lib/types';

  type Row = FinderProduct & { key: string; isKey: string; oldKeys: string[] };
  type Scale = 'micro' | 'small' | 'medium' | 'large' | 'foreign';

  const section = document.querySelector<HTMLElement>('[data-finder]');
  if (section) {
    const config = JSON.parse(section.dataset.config!) as {
      crs: [number, number, number, number];
      crsTest: number;
      isiOther: { application: number; licence: number; audit: number };
      consulting: string;
      whatsapp: string;
      services: { crs: string; isi: string };
    };
    const $ = <T extends Element = HTMLElement>(sel: string, root: ParentNode = section) => root.querySelector<T>(sel)!;
    const search = $<HTMLFormElement>('[data-finder-form]');
    const input = $<HTMLInputElement>('#finder-q');
    const clear = $('[data-clear]');
    const count = $('[data-count]');
    const list = $('[data-results]');
    const more = $('[data-more]');
    const empty = $('[data-empty]');
    const rowTemplate = $<HTMLTemplateElement>('template[data-row]');
    const PAGE = 10;
    const SCALES: Scale[] = ['micro', 'small', 'medium', 'large'];
    const SCALE_LABEL: Record<Scale, string> = { micro: 'Micro', small: 'Small', medium: 'Medium', large: 'Large', foreign: 'Foreign manufacturer' };
    const SCHEME_LABEL = { isi: 'ISI mark', crs: 'CRS registration' };

    const norm = (s: string) => s.toLowerCase().normalize('NFKD').replace(/[^a-z0-9]+/g, ' ').trim();
    const stem = (t: string) => (t.length > 3 && t.endsWith('s') && !t.endsWith('ss') ? t.slice(0, -1) : t);
    const isKey = (s: string) => norm(s.replace(/^\s*IS\b[\s:-]*/i, ''));

    let rows: Row[] | null = null;
    let loading: Promise<Row[]> | null = null;
    const load = () =>
      (loading ??= fetch('/resources/standards/products.json')
        .then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        .then((data: FinderProduct[]) => (rows = data.map((p) => ({ ...p, key: norm(p.n), isKey: isKey(p.i), oldKeys: p.r ? p.r.split(' / ').map(isKey) : [] }))))
        .catch((e) => {
          loading = null;
          throw e;
        }));

    const mode = () => search.querySelector<HTMLInputElement>('input[name="mode"]:checked')!.value as 'name' | 'is' | 'hsn';
    const scheme = () => search.querySelector<HTMLInputElement>('input[name="scheme"]:checked')!.value;

    function rank(p: Row, q: string, m: ReturnType<typeof mode>): number {
      if (m === 'hsn') {
        const h = p.h ?? '';
        if (!h) return -1;
        return h === q ? 0 : q.startsWith(h) ? 1 : h.startsWith(q) ? 2 : -1;
      }
      if (m === 'is') {
        const ranks = [p.isKey, ...p.oldKeys].map((k) => {
          if (k === q || k.startsWith(`${q} `)) return 0;
          if (k.startsWith(q) || k.replaceAll(' ', '').startsWith(q.replaceAll(' ', ''))) return 1;
          return k.includes(` ${q}`) ? 2 : -1;
        }).filter((r) => r >= 0);
        return ranks.length ? Math.min(...ranks) : -1;
      }
      const tokens = q.split(' ').map(stem);
      if (!tokens.every((t) => p.key.includes(t))) return -1;
      if (p.key.startsWith(q)) return 0;
      return tokens.every((t) => ` ${p.key}`.includes(` ${t}`)) ? 1 : 2;
    }

    const mandatory = (p: Row) => (p.w?.startsWith('Mandatory') ? 1 : 0);

    let matches: Row[] = [];
    let shown = 0;
    let query = '';

    function feeFrom(p: Row): string {
      if (p.s === 'crs') return `from ${rupees(config.crs[0])}`;
      return p.f ? `from ${rupees(p.f[0])}/yr` : 'On request';
    }

    function renderRows() {
      const slice = matches.slice(shown, shown + PAGE);
      for (const p of slice) {
        const li = rowTemplate.content.firstElementChild!.cloneNode(true) as HTMLElement;
        $('[data-name]', li).textContent = p.n;
        $('[data-scheme]', li).textContent = SCHEME_LABEL[p.s];
        $('[data-is]', li).textContent = p.i;
        $('[data-hsn]', li).textContent = p.h ? `HSN ${p.h}` : '';
        $('[data-when]', li).textContent = p.w ?? 'Not notified yet';
        $('[data-fee-label]', li).textContent = p.s === 'crs' ? 'BIS fee' : 'Minimum marking fee';
        $('[data-fee]', li).textContent = feeFrom(p);
        const btn = $<HTMLButtonElement>('[data-explore]', li);
        btn.setAttribute('aria-label', `Explore ${p.n}, ${p.i}`);
        btn.addEventListener('click', () => openProduct(p));
        list.append(li);
      }
      shown += slice.length;
      more.hidden = shown >= matches.length;
      count.textContent = matches.length > shown ? `Showing ${shown} of ${matches.length} products` : `${matches.length} product${matches.length === 1 ? '' : 's'} found`;
    }

    async function run() {
      const raw = input.value.trim();
      const m = mode();
      const q = m === 'hsn' ? raw.replace(/\D/g, '') : m === 'is' ? isKey(raw) : norm(raw);
      clear.hidden = !raw;
      list.replaceChildren();
      shown = 0;
      matches = [];
      empty.hidden = true;
      if (q.length < (m === 'is' ? 1 : 2)) {
        list.hidden = more.hidden = true;
        count.textContent = '';
        return;
      }
      let data = rows;
      try {
        if (!data) {
          count.textContent = 'Loading products…';
          data = await load();
        }
      } catch {
        count.textContent = 'Could not load the product list. Please try again, or ask us below.';
        return;
      }
      if (input.value.trim() !== raw || mode() !== m) return;
      query = raw;
      const s = scheme();
      matches = data
        .map((p) => ({ p, r: s === 'all' || p.s === s ? rank(p, q, m) : -1 }))
        .filter((x) => x.r >= 0)
        .sort((a, b) => a.r - b.r || mandatory(b.p) - mandatory(a.p) || a.p.n.length - b.p.n.length)
        .map((x) => x.p);
      list.hidden = !matches.length;
      if (!matches.length) {
        count.textContent = '';
        more.hidden = true;
        empty.hidden = false;
        $('[data-empty-q]').textContent = `“${raw}”`;
        track('fee_search_empty', `${m}:${raw}`);
        return;
      }
      renderRows();
    }

    let timer = 0;
    input.addEventListener('input', () => {
      clearTimeout(timer);
      timer = window.setTimeout(run, 150);
    });
    input.addEventListener('focus', () => void load().catch(() => {}), { once: true });
    search.addEventListener('submit', (e) => {
      e.preventDefault();
      input.blur();
      run();
    });
    search.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === 'mode') {
        input.placeholder = t.dataset.placeholder ?? '';
        input.inputMode = t.dataset.inputmode ?? 'search';
        input.focus();
      }
      if (t.name === 'mode' || t.name === 'scheme') run();
    });
    clear.addEventListener('click', () => {
      input.value = '';
      run();
      input.focus();
    });
    more.addEventListener('click', renderRows);
    section.querySelectorAll<HTMLButtonElement>('[data-suggest]').forEach((b) =>
      b.addEventListener('click', () => {
        search.querySelector<HTMLInputElement>('input[name="mode"][value="name"]')!.checked = true;
        input.placeholder = search.querySelector<HTMLInputElement>('input[name="mode"]:checked')!.dataset.placeholder ?? '';
        input.inputMode = 'search';
        input.value = b.textContent ?? '';
        run();
      }),
    );
    $('[data-ask]').addEventListener('click', () => {
      const product = document.querySelector<HTMLInputElement>('#quote input[name="product"]');
      if (product) product.value = query.slice(0, 190);
    });
    new IntersectionObserver(
      (entries, observer) => {
        if (entries.some((e) => e.isIntersecting)) {
          observer.disconnect();
          load().catch(() => {});
        }
      },
      { rootMargin: '400px' },
    ).observe(section);

    // Explore → lead form → fee breakdown
    const dialog = $<HTMLDialogElement>('#fee-dialog');
    const gate = $<HTMLFormElement>('form[data-lead-form]', dialog);
    const result = $('[data-fee-result]', dialog);
    let current: Row | null = null;

    const field = (name: string) => gate.elements.namedItem(name) as HTMLInputElement;
    const savedScale = () => {
      const [scale, at] = (prefStorage().getItem('ic_fee_scale') ?? '').split('|');
      return Number(at) > Date.now() - 30 * 86_400_000 ? (scale as Scale) : null;
    };
    const saveScale = (scale: Scale) => prefStorage().setItem('ic_fee_scale', `${scale}|${Date.now()}`);

    function syncLead() {
      if (!current) return;
      const scale = (gate.querySelector<HTMLInputElement>('input[name="scale"]:checked')?.value ?? '') as Scale | '';
      const foreign = scale === 'foreign';
      field('product').value = `${current.n} – ${current.i} (${SCHEME_LABEL[current.s]})`.slice(0, 190);
      field('service_path').value = config.services[current.s];
      field('manufacturer_type').value = scale ? (foreign ? 'foreign' : 'indian') : '';
      field('message').value = [`BIS fee finder: ${current.n}`, current.i, current.h && `HSN ${current.h}`, scale && `Business: ${SCALE_LABEL[scale]}`].filter(Boolean).join(' · ');
    }

    function renderFees(scale: Scale | null) {
      if (!current) return;
      const p = current;
      const foreign = scale === 'foreign';
      const idx = scale && !foreign ? SCALES.indexOf(scale) : -1;
      const set = (sel: string, text: string) => ($(sel, dialog).textContent = text);
      set('[data-r-when]', p.w ?? 'Not notified yet');
      set('[data-r-consulting]', config.consulting);
      const other = $('[data-r-other-row]', dialog);

      if (p.s === 'crs') {
        const fees = config.crs;
        set('[data-r-fee-label]', 'BIS registration fee');
        set('[data-r-fee]', scale ? rupees(foreign ? fees[3] : fees[idx]) : `From ${rupees(fees[0])}`);
        set('[data-r-fee-note]', `Micro ${rupees(fees[0])} · Small ${rupees(fees[1])} · Medium ${rupees(fees[2])} · Large and foreign ${rupees(fees[3])}. Same for every CRS product.`);
        set('[data-r-test]', `From ${rupees(config.crsTest)}`);
        other.hidden = true;
      } else {
        set('[data-r-fee-label]', 'Minimum marking fee (per year)');
        if (foreign) {
          set('[data-r-fee]', 'Get a detailed quote');
          set('[data-r-fee-note]', 'BIS fees for factories outside India depend on the product and the factory.');
        } else if (p.f) {
          set('[data-r-fee]', scale ? rupees(p.f[idx]) : `From ${rupees(p.f[0])}`);
          const note = SCALES.map((s, i) => `${SCALE_LABEL[s]} ${rupees(p.f![i])}`).join(' · ');
          set('[data-r-fee-note]', p.u ? `${note}. Marking fee ${p.u}: you pay this or the yearly minimum, whichever is higher.` : `${note}.`);
        } else {
          set('[data-r-fee]', 'Get a detailed quote');
          set('[data-r-fee-note]', p.u ? `Marking fee ${p.u}.` : '');
        }
        const { application, licence, audit } = config.isiOther;
        set('[data-r-other]', foreign ? 'Get a detailed quote' : rupees(application + licence + audit));
        set(
          '[data-r-other-note]',
          foreign
            ? ''
            : `For every ISI mark product: application charge ${rupees(application)} · licence fee ${rupees(licence)} · audit charges ${rupees(audit)}.`,
        );
        set('[data-r-test]', p.t ? `From ${rupees(p.t)}` : 'Depends on the lab – in your quote');
        other.hidden = false;
      }

      dialog.querySelectorAll<HTMLInputElement>('input[name="view-scale"]').forEach((r) => (r.checked = r.value === scale));
      const text = `Hi Instacertify, I checked the BIS fees for ${p.n} (${p.i}). Let’s discuss my requirement.`;
      $<HTMLAnchorElement>('[data-r-wa]', dialog).href = `https://wa.me/${config.whatsapp}?text=${encodeURIComponent(text)}`;
    }

    function showFees(scale: Scale | null, fresh: boolean) {
      gate.hidden = true;
      result.hidden = false;
      $('[data-thanks]', dialog).hidden = !fresh;
      renderFees(scale);
    }

    function openProduct(p: Row) {
      current = p;
      $('[data-d-scheme]', dialog).textContent = SCHEME_LABEL[p.s];
      $('[data-d-name]', dialog).textContent = p.n;
      $('[data-d-meta]', dialog).textContent = [p.i, p.h && `HSN ${p.h}`].filter(Boolean).join(' · ');
      const scale = savedScale();
      if (scale) showFees(scale, false);
      else {
        gate.hidden = false;
        result.hidden = true;
        syncLead();
      }
      dialog.showModal();
      track('fee_explore', `${p.s}:${p.i}`);
    }

    gate.addEventListener('change', syncLead);
    gate.addEventListener('lead:sent', () => {
      const scale = (gate.querySelector<HTMLInputElement>('input[name="scale"]:checked')?.value ?? 'micro') as Scale;
      saveScale(scale);
      showFees(scale, true);
    });
    result.addEventListener('change', (e) => {
      const scale = (e.target as HTMLInputElement).value as Scale;
      saveScale(scale);
      renderFees(scale);
    });
    $('[data-close]', dialog).addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  }
</script>
