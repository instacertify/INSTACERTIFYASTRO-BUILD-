---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import Icon from './Icon.astro';
import CtaBand from './CtaBand.astro';
import { eventPlace, formatDate, getEvents, getSite, industriesOf, schemesOf } from '../lib/content';
import { breadcrumbSchema } from '../lib/breadcrumbs';
import { responsive } from '../lib/images';
import type { EventItem } from '../lib/types';

const [events, site] = await Promise.all([getEvents(), getSite()]);
const today = new Date().toISOString().slice(0, 10);
const isUpcoming = (e: EventItem) => (e.endsAt ?? e.startsAt).slice(0, 10) >= today;
const upcoming = events.filter(isUpcoming).sort((a, b) => a.startsAt.localeCompare(b.startsAt));
const thumbs = new Map(await Promise.all(upcoming.map(async (e) => [e.slug, await responsive(e.image, [96, 192])] as const)));
const past = events.filter((e) => !isUpcoming(e)).sort((a, b) => b.startsAt.localeCompare(a.startsAt));
const trail = [{ label: 'Resources', href: '/resources' }, { label: 'Events' }];

/** Groups keep the order of the (already sorted) list. */
const groupBy = (list: EventItem[], key: (e: EventItem) => string) => {
  const groups = new Map<string, EventItem[]>();
  list.forEach((e) => groups.set(key(e), [...(groups.get(key(e)) ?? []), e]));
  return [...groups];
};
const upcomingByMonth = groupBy(upcoming, (e) => formatDate(e.startsAt, { month: 'long', year: 'numeric' }));
const pastByYear = groupBy(past, (e) => formatDate(e.startsAt, { year: 'numeric' }));

const endsOtherDay = (e: EventItem) => e.endsAt && formatDate(e.endsAt) !== formatDate(e.startsAt);
const dateRange = (e: EventItem) =>
  endsOtherDay(e) ? `${formatDate(e.startsAt, { day: 'numeric', month: 'short' })} – ${formatDate(e.endsAt)}` : formatDate(e.startsAt);
const searchText = (e: EventItem) => [e.title, e.location, e.excerpt, e.industry?.name, formatDate(e.startsAt, { month: 'long', year: 'numeric' })].join(' ').toLowerCase();
const industries = industriesOf(events);
const schemes = schemesOf(events);
const certs = (e: EventItem) => (e.schemes ?? []).map((s) => s.slug).join(' ');

const jumps = [
  ...(upcoming.length ? [{ id: 'upcoming', label: 'Upcoming', count: upcoming.length }] : []),
  ...pastByYear.map(([year, list]) => ({ id: `past-${year}`, label: `Past ${year}`, count: list.length })),
];

const jsonLd = [
  breadcrumbSchema(site.url, trail, 'resources/events'),
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Upcoming industry events and trade fairs',
    itemListElement: upcoming.map((e, i) => ({ '@type': 'ListItem', position: i + 1, url: `${site.url}${e.url}`, name: e.title })),
  },
];
---

<Layout title="Industry Events & Trade Fairs | Instacertify" description="Upcoming trade fairs and industry events for electronics, machinery, food, beverages and more, with dates, venues and what each event covers." jsonLd={jsonLd}>
  <section class="border-b border-slate-200 surface-tint">
    <div class="container-page py-8 sm:py-12">
      <Breadcrumbs items={trail} />
      <h1 class="mt-5 text-[2rem] leading-tight font-bold sm:text-[2.5rem]">Industry events & trade fairs</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">Dates, venues and what each fair covers, for the trade shows that matter to manufacturers and importers. Exhibiting abroad or bringing products to India? Ask us which certifications they need first.</p>
    </div>
  </section>

  {events.length > 0 && (
    <div class="z-30 border-b border-slate-200 bg-white/95 sm:sticky sm:top-16 backdrop-blur supports-[backdrop-filter]:bg-white/85">
      <div class="container-page flex flex-col gap-3 py-3 lg:flex-row lg:items-center">
        <div class="flex flex-col gap-2 sm:flex-row lg:shrink-0">
          <label class="relative block min-w-0 flex-1 lg:w-72 lg:flex-none">
            <span class="sr-only">Search events</span>
            <Icon name="search" class="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-slate-400" />
            <input id="ev-search" type="search" placeholder="Search by event or country" autocomplete="off" class="field min-h-10 pl-9" />
          </label>
          {industries.length > 1 && (
            <div class="sm:w-60 sm:shrink-0">
              <label for="ev-industry" class="sr-only">Filter by industry</label>
              <select id="ev-industry" class="field min-h-10 truncate" autocomplete="off">
                <option value="">All industries ({events.length})</option>
                {industries.map((c) => <option value={c.slug}>{c.name} ({c.count})</option>)}
              </select>
            </div>
          )}
          {schemes.length > 1 && (
            <div class="sm:w-60 sm:shrink-0">
              <label for="ev-cert" class="sr-only">Filter by certification</label>
              <select id="ev-cert" class="field min-h-10 truncate" autocomplete="off">
                <option value="">All certifications</option>
                {schemes.map((s) => <option value={s.slug}>{s.name} ({s.count})</option>)}
              </select>
            </div>
          )}
        </div>
        <nav aria-label="Jump to" class="-mx-4 overflow-x-auto px-4 sm:mx-0 sm:px-0">
          <ul class="flex gap-2 whitespace-nowrap">
            {jumps.map((j) => (
              <li><a href={`#${j.id}`} data-jump={j.id} class="chip min-h-9 aria-[current=true]:border-brand-700 aria-[current=true]:bg-brand-700 aria-[current=true]:text-white">{j.label} <span class="text-xs opacity-70" data-jump-count>{j.count}</span></a></li>
            ))}
          </ul>
        </nav>
      </div>
    </div>
  )}

  <div id="ev-results" class="container-page space-y-14 py-10 sm:py-12">
    <p id="ev-empty" class="text-slate-600" hidden>No events match your search. <button type="button" id="ev-clear" class="font-semibold text-brand-700 hover:underline">Clear filters</button></p>

    {upcoming.length > 0 && (
      <section id="upcoming" data-ev-group aria-labelledby="upcoming-h" class="scroll-mt-14">
        <h2 id="upcoming-h" class="text-2xl section-title">Upcoming events</h2>
        {upcomingByMonth.map(([month, list]) => (
          <div data-ev-group class="mt-6">
            <h3 class="text-sm font-semibold text-slate-500">{month}</h3>
            <ul class="mt-3 grid grid-cols-1 gap-4 md:grid-cols-2">
              {list.map((e) => (
                <li data-ev={searchText(e)} data-industry={e.industry?.slug ?? ''} data-cert={certs(e)}>
                  <a href={e.url} class="card-hover group flex h-full items-start gap-4 p-4">
                    <span class="flex w-14 shrink-0 flex-col items-center rounded-lg bg-brand-50 py-2 text-brand-700">
                      <span class="text-xs font-semibold uppercase">{formatDate(e.startsAt, { month: 'short' })}</span>
                      <span class="text-xl leading-none font-bold">{formatDate(e.startsAt, { day: 'numeric' })}</span>
                    </span>
                    <span class="min-w-0 flex-1">
                      <span class="block line-clamp-2 font-semibold text-slate-900 group-hover:text-brand-700">{e.title}</span>
                      {endsOtherDay(e) && <span class="mt-1 block text-sm text-slate-600">{dateRange(e)}</span>}
                      {eventPlace(e) && <span class="mt-0.5 flex items-center gap-1 text-sm text-slate-500"><Icon name="map-pin" class="size-3.5 shrink-0" /><span class="truncate">{eventPlace(e)}</span></span>}
                    </span>
                    {thumbs.get(e.slug) && <img src={thumbs.get(e.slug)!.src} srcset={thumbs.get(e.slug)!.srcset} sizes="96px" alt="" width="96" height="72" loading="lazy" decoding="async" class="hidden h-16 w-24 shrink-0 rounded-md bg-white object-contain sm:block" />}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}

    {pastByYear.map(([year, list]) => (
      <section id={`past-${year}`} data-ev-group aria-labelledby={`past-${year}-h`} class="scroll-mt-14">
        <h2 id={`past-${year}-h`} class="text-2xl section-title">Past events, {year}</h2>
        <ul class="mt-5 grid grid-cols-1 gap-x-8 sm:grid-cols-2 lg:grid-cols-3">
          {list.map((e) => (
            <li data-ev={searchText(e)} data-industry={e.industry?.slug ?? ''} data-cert={certs(e)} class="border-b border-slate-200">
              <a href={e.url} class="group flex items-start gap-3 py-3">
                <span class="w-14 shrink-0 pt-0.5 text-xs font-semibold text-slate-500 uppercase">{formatDate(e.startsAt, { day: 'numeric', month: 'short' })}</span>
                <span class="min-w-0">
                  <span class="block line-clamp-2 text-base font-medium text-slate-800 group-hover:text-brand-700">{e.title}</span>
                  {eventPlace(e) && <span class="mt-0.5 block truncate text-sm text-slate-500">{eventPlace(e)}</span>}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {events.length === 0 && <p class="text-slate-600">No events are listed right now.</p>}
  </div>

  <CtaBand />
</Layout>

<script>
  const input = document.querySelector<HTMLInputElement>('#ev-search');
  const industry = document.querySelector<HTMLSelectElement>('#ev-industry');
  const cert = document.querySelector<HTMLSelectElement>('#ev-cert');
  const empty = document.querySelector<HTMLElement>('#ev-empty');
  const items = [...document.querySelectorAll<HTMLElement>('[data-ev]')];
  const groups = [...document.querySelectorAll<HTMLElement>('[data-ev-group]')];
  const jumps = [...document.querySelectorAll<HTMLAnchorElement>('[data-jump]')];

  const filter = () => {
    const words = (input?.value ?? '').toLowerCase().split(/\s+/).filter(Boolean);
    const sector = industry?.value ?? '';
    const scheme = cert?.value ?? '';
    items.forEach((li) => (li.hidden =
      (!!sector && li.dataset.industry !== sector) ||
      (!!scheme && !li.dataset.cert!.split(' ').includes(scheme)) ||
      !words.every((w) => li.dataset.ev!.includes(w))));
    const url = new URL(location.href);
    for (const [key, value] of [['industry', sector], ['cert', scheme]]) {
      if (value) url.searchParams.set(key, value);
      else url.searchParams.delete(key);
    }
    history.replaceState(null, '', url);
    groups.forEach((g) => (g.hidden = !g.querySelector('[data-ev]:not([hidden])')));
    jumps.forEach((a) => {
      const section = document.getElementById(a.dataset.jump!);
      a.parentElement!.hidden = !!section?.hidden;
      const count = a.querySelector('[data-jump-count]');
      if (section && count) count.textContent = String(section.querySelectorAll('[data-ev]:not([hidden])').length);
    });
    if (empty) empty.hidden = items.some((li) => !li.hidden);
    // Keep the first results under the search bar instead of leaving the reader below a shorter list.
    const results = document.getElementById('ev-results');
    const top = results?.getBoundingClientRect().top ?? 0;
    if (top < 0) window.scrollTo({ top: top + scrollY - 130, behavior: 'instant' });
  };
  input?.addEventListener('input', filter);
  industry?.addEventListener('change', filter);
  cert?.addEventListener('change', filter);
  document.querySelector('#ev-clear')?.addEventListener('click', () => {
    if (input) input.value = '';
    if (industry) industry.value = '';
    if (cert) cert.value = '';
    filter();
    input?.focus();
  });
  const params = new URLSearchParams(location.search);
  const presets = [[industry, params.get('industry')], [cert, params.get('cert')]] as const;
  presets.forEach(([select, value]) => {
    if (select && value && [...select.options].some((o) => o.value === value)) select.value = value;
  });
  if (presets.some(([select]) => select?.value)) filter();

  // Highlight the jump link of the section at the top of the screen.
  const sections = jumps.map((a) => document.getElementById(a.dataset.jump!)).filter((s): s is HTMLElement => !!s);
  const mark = () => {
    const line = 160;
    const active = sections.filter((s) => !s.hidden && s.getBoundingClientRect().top <= line).pop() ?? sections.find((s) => !s.hidden);
    jumps.forEach((a) => a.setAttribute('aria-current', String(a.dataset.jump === active?.id)));
  };
  addEventListener('scroll', mark, { passive: true });
  mark();
</script>
