# Docker Compose settings — copy to .env and fill in strong values.

SITE_DOMAIN=localhost
API_DOMAIN=api.localhost
ANALYTICS_DOMAIN=analytics.localhost
AUTOMATION_DOMAIN=n8n.localhost
ERRORS_DOMAIN=errors.localhost
GRAFANA_DOMAIN=grafana.localhost
ACME_EMAIL=admin@instacertify.com

# Generate with: php backend/artisan key:generate --show
APP_KEY=
ADMIN_EMAIL=admin@instacertify.com
ADMIN_PASSWORD=

POSTGRES_PASSWORD=
MINIO_ROOT_USER=instacertify
MINIO_ROOT_PASSWORD=
MEILI_MASTER_KEY=
# Shared secret between Laravel and the site builder (32+ random characters), e.g. php -r "echo bin2hex(random_bytes(24));"
SITE_PUBLISH_TOKEN=

# Leave MAIL_HOST as mailpit locally; point at Postal/SMTP in production.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@instacertify.com
LEAD_NOTIFY_EMAIL=contact@instacertify.com

# n8n webhook that receives every new lead (signed with LEAD_WEBHOOK_SECRET)
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

PUBLIC_MATOMO_URL=
MATOMO_DB_PASSWORD=
GLITCHTIP_SECRET_KEY=
GRAFANA_ADMIN_PASSWORD=
EVOLUTION_API_KEY=
